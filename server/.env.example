# Copy this to .env (never commit real keys)
OPENAI_API_KEY=sk_...
OPENAI_MODEL=gpt-4o
PORT=3000

# Restrict which origin can call the proxy (recommended)
ALLOWED_ORIGIN=http://localhost:5500
# or set ALLOW_ALL_ORIGINS=true (not recommended)

# Optional header-based project secret to protect endpoint
PROJECT_SECRET=some-random-secret
